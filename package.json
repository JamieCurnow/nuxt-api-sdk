{
  "name": "nuxt-api-sdk",
  "version": "0.1.0",
  "description": "Turn nuxt server routes into an SDK.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamieCurnow/nuxt-api-sdk.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "npm run lint && npm run test && npm run test:types && changelogen --release && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run --project unit --coverage && vitest run --project e2e",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.1"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.7.0",
    "@nuxt/eslint-config": "^1.10.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.1",
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "latest",
    "@vitest/coverage-v8": "^4.0.8",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.1",
    "eslint-plugin-prettier": "^5.5.4",
    "nuxt": "^4.6.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.6",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "vitest": "^4.0.6"
  }
}
